{
    "name": "beljic/php-fit-sdk",
    "description": "Modern PHP 8.3+ library for parsing and analyzing Garmin FIT files",
    "type": "library",
    "license": "MIT",
    "keywords": ["fit", "garmin", "gps", "fitness", "activity", "parser", "running", "cycling"],
    "authors": [
        {
            "name": "Dejan Beljic",
            "email": "beljic@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Beljic\\FitSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beljic\\FitSdk\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fit"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
